{
	"compilerOptions": {
		"target": "es2023",
		"module": "nodenext",
		"strict": true,
		"noEmit": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src", "test", "scripts"]
}
